{
  "_说明": "改完重启小白生效。workspace、guardPolicy、bridgeRuntime、vision.keyFile 这几个路径留空就用仓库里的默认位置，要改可以写绝对路径（反斜杠写两个）或者相对仓库根目录的路径。表情怎么配见仓库根目录的 README。",
  "workspace": "",
  "dshCommand": "npx @deepseek-ai/dsh web --no-open",
  "attachUrl": "",
  "port": 3080,
  "guardPolicy": "",
